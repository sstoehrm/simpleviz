# build output
node_modules/
public/js/
dist/

# editor / LSP tooling: of .clj-kondo only the shared config.edn is
# committed, not its cache or imported library configs; an .lsp/config.edn
# stays committable
.clj-kondo/*
!.clj-kondo/config.edn
.lsp/.cache/
.nrepl-port
.idea/
.vscode/
*.iml

# local secrets: commit a .env.example instead
.env
.env.*
!.env.example

# Claude Code session scratch
.claude/worktrees/
.superpowers/

# Local feature worktrees
.worktrees/

# private example, never bundled
examples/mps-architecture.edn

# what presenting an example deck answered
examples/*.answers.edn

# the running-server registry of a test that uses the repo as its home
/servers/

# blend build plan, local
.blend/plan.*
