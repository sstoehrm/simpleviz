{:paths ["server" "test" "."]
 :deps {metosin/malli {:mvn/version "0.19.1"}}
 :tasks
 {:init (defn release-version
          "The version a release artifact carries: the task's first argument,
          else `git describe`, else \"dev\"."
          []
          (or (first *command-line-args*)
              (some-> (shell {:out :string :continue true} "git describe --tags --always")
                      :out clojure.string/trim not-empty)
              "dev"))

  build    {:doc "Install npm deps and compile squint sources"
            :requires ([babashka.fs :as fs])
            :task (do (when-not (fs/exists? "node_modules")
                        (shell "npm install"))
                      (shell "npx squint compile")
                      (fs/create-dirs "public/js/vendor")
                      (fs/copy-tree "node_modules/reagami" "public/js/vendor/reagami"
                                    {:replace-existing true})
                      (fs/copy-tree "node_modules/squint-cljs" "public/js/vendor/squint-cljs"
                                    {:replace-existing true}))}
  serve    {:doc "Serve an EDN graph file or exported PNG: bb serve graph.edn|.png [suffix] [--port N] (suffix = compare against graph-<suffix>.edn)"
            :requires ([serve])
            :task (apply serve/-main *command-line-args*)}
  extract  {:doc "Extract embedded EDN from an exported PNG: bb extract diagram.png [out.edn] [--old]"
            :requires ([png])
            :task (apply png/-main *command-line-args*)}
  check    {:doc "Report a graph's parse error or validation warnings (exit 1 on any): bb check graph.edn|.png"
            :requires ([check])
            :task (apply check/-main *command-line-args*)}
  fork     {:doc "Fork a graph and every file it refs: bb fork graph.edn <suffix> (writes graph-<suffix>.edn ...)"
            :requires ([fork])
            :task (apply fork/-main "fork" *command-line-args*)}
  promote  {:doc "Move each fork over its base file: bb promote graph.edn <suffix>"
            :requires ([fork])
            :task (apply fork/-main "promote" *command-line-args*)}
  test:clj {:doc "Run Clojure server tests"
            :requires ([clojure.test :as t] [server-test] [graph-test] [diff-test] [docs-test] [png-test] [edit-test] [log-test] [fork-test] [launcher-test] [check-test] [cli-test])
            :task (let [{:keys [fail error]} (t/run-tests 'graph-test 'server-test 'diff-test 'docs-test 'png-test 'edit-test 'log-test 'fork-test 'launcher-test 'check-test 'cli-test)]
                    (when (pos? (+ fail error)) (System/exit 1)))}
  test:js  {:doc "Run JS unit tests (compiled squint output)"
            :requires ([babashka.fs :as fs])
            :task (let [files (map str (fs/glob "public/js/simpleviz" "*_test.mjs"))]
                    (if (empty? files)
                      (do (println "no compiled tests found — run bb build")
                          (System/exit 1))
                      (apply shell "node" "--test" files)))}
  test     {:doc "Run all tests"
            :depends [build test:clj test:js]}
  bundle   {:doc "Build a release tarball into dist/: bb bundle [version]"
            :depends [build]
            :requires ([babashka.fs :as fs] [clojure.edn :as edn] [clojure.string :as str])
            :task (let [version (release-version)
                        bundle-name (str "simpleviz-" version)
                        dir (fs/path "dist" bundle-name)
                        ;; standalone bb.edn: serving only, deps taken from this file
                        release-bb {:paths ["server" "."]
                                    :deps (:deps (edn/read-string (slurp "bb.edn")))
                                    :tasks (quote {serve {:doc "Serve an EDN graph file or exported PNG: bb serve graph.edn|.png [suffix] [--port N] (suffix = compare against graph-<suffix>.edn)"
                                                          :requires ([serve])
                                                          :task (apply serve/-main *command-line-args*)}
                                                   extract {:doc "Extract embedded EDN from an exported PNG: bb extract diagram.png [out.edn] [--old]"
                                                            :requires ([png])
                                                            :task (apply png/-main *command-line-args*)}
                                                   check {:doc "Report a graph's parse error or validation warnings (exit 1 on any): bb check graph.edn|.png"
                                                          :requires ([check])
                                                          :task (apply check/-main *command-line-args*)}
                                                   fork {:doc "Fork a graph and every file it refs: bb fork graph.edn <suffix> (writes graph-<suffix>.edn ...)"
                                                         :requires ([fork])
                                                         :task (apply fork/-main "fork" *command-line-args*)}
                                                   promote {:doc "Move each fork over its base file: bb promote graph.edn <suffix>"
                                                            :requires ([fork])
                                                            :task (apply fork/-main "promote" *command-line-args*)}})}]
                    (fs/delete-tree dir)
                    (fs/create-dirs dir)
                    (doseq [p ["public" "server" "examples"]]
                      (fs/copy-tree p (fs/path dir p)))
                    (doseq [f (fs/glob dir "public/js/simpleviz/*_test.mjs")]
                      (fs/delete f))
                    (doseq [f ["README.md" "LICENSE" "THIRD-PARTY-NOTICES.md"]]
                      (fs/copy f (fs/path dir f)))
                    (spit (str (fs/path dir "VERSION")) (str version "\n"))
                    (spit (str (fs/path dir "bb.edn"))
                          (binding [*print-namespace-maps* false] (pr-str release-bb)))
                    (shell {:dir "dist"} "tar" "czf" (str bundle-name ".tar.gz") bundle-name)
                    (println (str "created dist/" bundle-name ".tar.gz")))}
  jar      {:doc "Build dist/simpleviz.jar, the release jar bbin installs: bb jar [version]"
            :depends [build]
            :requires ([babashka.fs :as fs] [clojure.edn :as edn] [clojure.string :as str])
            :task (let [version (release-version)
                        stage (fs/path "dist" "jar-stage")
                        res (fs/path stage "res")
                        jar "dist/simpleviz.jar"]
                    (fs/delete-tree stage)
                    (fs/create-dirs res)
                    (fs/copy-tree "server" (fs/path stage "server"))
                    (fs/copy-tree "public" (fs/path res "public"))
                    (doseq [f (fs/glob res "public/js/simpleviz/*_test.mjs")]
                      (fs/delete f))
                    (fs/copy-tree "examples" (fs/path res "examples"))
                    (spit (str (fs/path res "VERSION")) (str version "\n"))
                    (doseq [f ["LICENSE" "THIRD-PARTY-NOTICES.md"]]
                      (fs/copy f (fs/path res f)))
                    (spit (str (fs/path stage "bb.edn"))
                          (pr-str {:paths ["server" "res"]
                                   :deps (:deps (edn/read-string (slurp "bb.edn")))}))
                    (fs/delete-if-exists jar)
                    (shell {:dir (str stage)} "bb" "uberjar" "../simpleviz.jar" "-m" "cli")
                    ;; bb uberjar always drops a root file literally named LICENSE
                    ;; (babashka.main's uberjar! hardcodes it into :exclude, "Preserve
                    ;; depstar's exclusions"); add it back so the jar carries the same
                    ;; LICENSE the tarball does.
                    (with-open [zfs (java.nio.file.FileSystems/newFileSystem
                                     (java.net.URI. (str "jar:" (.toUri (fs/absolutize jar)))) {})]
                      (java.nio.file.Files/copy (fs/path "LICENSE") (.getPath zfs "LICENSE" (make-array String 0))
                                                 (into-array java.nio.file.CopyOption [])))
                    ;; every Maven library packed into the jar needs a notice
                    (let [libs (with-open [z (java.util.zip.ZipFile. jar)]
                                 (->> (enumeration-seq (.entries z))
                                      (keep (fn [entry]
                                              (second (re-matches (re-pattern "META-INF/maven/([^/]+/[^/]+)/pom\\.properties")
                                                                   (.getName entry)))))
                                      distinct sort vec))
                          notices (slurp "THIRD-PARTY-NOTICES.md")
                          missing (remove (fn [lib] (str/includes? notices lib)) libs)]
                      (when (seq missing)
                        (println (str "THIRD-PARTY-NOTICES.md does not mention: " (str/join ", " missing)))
                        (System/exit 1)))
                    (println (str "created " jar " (" version ")")))}
  jar:smoke {:doc "Build the jar and run it the way bbin's shim does: --version, check, demo --no-open"
             :depends [jar]
             :requires ([babashka.fs :as fs] [babashka.process :as p] [cheshire.core :as json]
                        [clojure.string :as str] [proc-util])
             :task (let [tmp (fs/create-temp-dir {:prefix "simpleviz-jar-smoke"})
                         jar (str (fs/absolutize "dist/simpleviz.jar"))
                         shim (str (fs/path tmp "simpleviz"))
                         run (fn [& args]
                               (apply p/shell {:dir (str tmp) :out :string :err :string :continue true}
                                      "bb" shim args))
                         ;; throws instead of exiting directly, so the finally blocks
                         ;; below (destroy-tree, delete-tree) run before we exit
                         fail (fn [& msg]
                                (throw (ex-info (apply str msg) {:smoke true})))]
                     (try
                       (try
                         ;; bbin's http-jar template, minus its metadata comments
                         (spit shim (str "(require '[babashka.classpath :refer [add-classpath]])\n"
                                         "(add-classpath " (pr-str jar) ")\n"
                                         "(require '[cli])\n"
                                         "(apply cli/-main *command-line-args*)\n"))
                         (with-open [z (java.util.zip.ZipFile. jar)]
                           (doseq [e ["LICENSE" "THIRD-PARTY-NOTICES.md" "VERSION"
                                      "public/index.html" "examples/demo.edn" "cli.clj"]]
                             (when-not (.getEntry z e) (fail "the jar lacks " e))))
                         (let [{:keys [out err]} (run "--version")]
                           (when-not (str/starts-with? out "simpleviz ")
                             (fail "--version printed " (pr-str out) " " err))
                           (print (str "ok: " out)))
                         (fs/copy "examples/demo.edn" (fs/path tmp "demo.edn"))
                         (let [{:keys [exit out err]} (run "check" "demo.edn")]
                           (when-not (= 0 exit) (fail "check demo.edn: " out err))
                           (println "ok: check demo.edn"))
                         (let [proc (p/process {:dir (str tmp) :err :inherit} "bb" shim "demo" "--no-open")]
                           (try
                             (let [[_ url] (proc-util/await-line proc (re-pattern "^simpleviz: (http://localhost:\\d+)$") 60000)]
                               (when-not url (fail "demo printed no URL"))
                               (when-not (str/includes? (slurp url) "<html") (fail "no page at " url))
                               (let [errs (json/parse-string (slurp (str url "/api/errors")))]
                                 (when-not (= {"error" nil "warnings" []} errs)
                                   (fail "demo reports " errs)))
                               (println (str "ok: demo serves " url)))
                             (finally (p/destroy-tree proc))))
                         (finally (fs/delete-tree tmp)))
                       (catch clojure.lang.ExceptionInfo e
                         (if (:smoke (ex-data e))
                           (do (println (str "jar:smoke FAILED: " (ex-message e)))
                               (System/exit 1))
                           (throw e)))))}
  dev      {:doc "Compile, watch and serve: bb dev [graph.edn [suffix]] [--port N]"
            :requires ([babashka.cli :as cli] [babashka.process :as p] [serve])
            :task (do (run 'build)
                      (p/process ["npx" "squint" "watch"] {:inherit true})
                      ;; prepend the default file unless a positional arg is present
                      (let [args *command-line-args*
                            positional (try (:args (cli/parse-args args serve/cli-spec))
                                            (catch Exception _ [:let-serve-report-it]))]
                        (apply serve/-main (if (seq positional) args (cons "examples/demo.edn" args)))))}}}
